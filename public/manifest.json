{
  "manifest_version": 3,
  "name": "Contributor Compass",
  "version": "0.1.0",
  "description": "Explore public GitHub repositories with clear evidence about activity and contribution opportunities.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Contributor Compass"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
